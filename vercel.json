{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/agentjam",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/momo",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/spatial-agent",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/spoken-english",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/research/worlds-not-windows",
      "destination": "/papers/worlds-not-windows",
      "permanent": true
    },
    {
      "source": "/research/worlds-not-windows/whitepaper",
      "destination": "/papers/worlds-not-windows/whitepaper",
      "permanent": true
    },
    {
      "source": "/research/whitepaper",
      "destination": "/papers/worlds-not-windows/whitepaper",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/branding/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/homepage-heroes/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/sidebar-variants/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
